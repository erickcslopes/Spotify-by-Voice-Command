# =============================
# Spotify
# =============================
SPOTIFY_CLIENT_ID=
# Porta/caminho do callback local do OAuth. NÃO use 1420 (porta do Vite).
# Registre a mesma URI em https://developer.spotify.com/dashboard
SPOTIFY_REDIRECT_URI=http://127.0.0.1:1421/callback

# =============================
# xAI (Grok) — apenas fallback
# =============================
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# =============================
# Voz (whisper.cpp local)
# =============================
WHISPER_MODEL=base
# Caminho do binário do whisper.cpp (default usa "whisper-cli")
WHISPER_BIN=whisper-cli
# Caminho completo do arquivo de modelo (ex.: C:\models\ggml-base.bin)
# Se vazio, usa WHISPER_MODELS_DIR/ggml-{WHISPER_MODEL}.bin ou o nome do modelo.
WHISPER_MODEL_PATH=
# Diretório onde ficam os modelos ggml-*.bin
WHISPER_MODELS_DIR=
# Timeout da transcrição em ms
WHISPER_TIMEOUT_MS=60000
# Duração mínima de gravação em ms (gravações mais curtas são descartadas)
MIN_RECORDING_MS=300

# =============================
# Spotify Voice Assistant
# =============================
# Incremento do volume relativo (ex.: "aumenta o volume")
VOLUME_STEP=10
# Porta do callback local do OAuth (deve casar com SPOTIFY_REDIRECT_URI; evitar 1420)
SPOTIFY_CALLBACK_PORT=1421